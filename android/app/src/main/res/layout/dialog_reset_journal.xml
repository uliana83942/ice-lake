<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/reset_dialog_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_dialog_surface"
    android:elevation="@dimen/elevation_dialog"
    android:paddingStart="@dimen/space_xl"
    android:paddingTop="@dimen/space_xl"
    android:paddingEnd="@dimen/space_xl"
    android:paddingBottom="@dimen/space_xl">

    <TextView
        android:id="@+id/txt_reset_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:text="@string/reset_title"
        android:textAppearance="@style/TextAppearance.IceLake.Title" />

    <TextView
        android:id="@+id/txt_reset_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/txt_reset_title"
        android:layout_marginTop="@dimen/space_m"
        android:text="@string/reset_body"
        android:textAppearance="@style/TextAppearance.IceLake.Body"
        android:textSize="@dimen/text_small" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_reset_cancel"
        style="@style/Widget.App.Button.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/button_secondary_height"
        android:layout_below="@id/txt_reset_body"
        android:layout_alignParentStart="true"
        android:layout_marginTop="@dimen/space_xl"
        android:minWidth="120dp"
        android:text="@string/reset_cancel" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_reset_confirm"
        style="@style/Widget.App.Button.Danger"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/button_secondary_height"
        android:layout_below="@id/txt_reset_body"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="@dimen/space_xl"
        android:minWidth="120dp"
        android:text="@string/reset_confirm"
        app:icon="@drawable/ic_check" />

</RelativeLayout>
