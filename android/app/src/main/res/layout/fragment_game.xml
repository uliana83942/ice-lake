<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/game_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_game_gradient">

    <ImageView
        android:id="@+id/img_game_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.30"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_game"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/game_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_m"
        android:paddingTop="@dimen/status_bar_pad"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_m"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_game_back"
            style="@style/Widget.App.Button.Icon"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:contentDescription="@string/game_back_desc"
            app:icon="@drawable/ic_back" />

        <TextView
            android:id="@+id/txt_game_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:layout_weight="1"
            android:text="@string/game_title"
            android:textAppearance="@style/TextAppearance.IceLake.Title" />

        <TextView
            android:id="@+id/txt_game_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/shape_chip_count"
            android:paddingStart="@dimen/space_m"
            android:paddingTop="@dimen/space_xs"
            android:paddingEnd="@dimen/space_m"
            android:paddingBottom="@dimen/space_xs"
            android:text="@string/value_none"
            android:textColor="@color/ice_primary"
            android:textSize="@dimen/text_chip" />

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_entry"
        style="@style/Widget.App.Card.Soft"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginEnd="@dimen/space_l"
        android:layout_marginBottom="@dimen/space_m"
        app:cardBackgroundColor="@color/card_translucent"
        app:cardCornerRadius="@dimen/radius_xl"
        app:cardElevation="@dimen/elevation_m"
        app:layout_constraintBottom_toTopOf="@id/game_action_band"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/game_header"
        app:strokeColor="@color/ice_stroke">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_entry"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/space_l"
            android:paddingTop="@dimen/space_l"
            android:paddingEnd="@dimen/space_l"
            android:paddingBottom="@dimen/space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.icelake.fishinglog.core.ui.SectionHeaderView
                    android:id="@+id/section_species"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/list_species"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/species_chip_size"
                    android:layout_marginTop="@dimen/space_m"
                    android:clipToPadding="false" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_preview"
                    style="@style/Widget.App.Card.Soft"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/preview_card_height"
                    android:layout_marginTop="@dimen/space_l"
                    app:cardBackgroundColor="@color/ice_surface_tint"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/space_l"
                        android:paddingEnd="@dimen/space_l">

                        <ImageView
                            android:id="@+id/img_preview_species"
                            android:layout_width="@dimen/preview_sprite_size"
                            android:layout_height="@dimen/preview_sprite_size"
                            android:contentDescription="@string/game_preview_desc"
                            android:scaleType="fitCenter"
                            android:src="@drawable/sprite_fish_pike" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_l"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txt_preview_species"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/value_none"
                                android:textAppearance="@style/TextAppearance.IceLake.Label" />

                            <TextView
                                android:id="@+id/txt_preview_weight"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:accessibilityLiveRegion="polite"
                                android:fontFeatureSettings="tnum"
                                android:maxLines="1"
                                android:text="@string/value_none"
                                android:textAppearance="@style/TextAppearance.IceLake.Numeric" />

                            <TextView
                                android:id="@+id/txt_preview_length"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFeatureSettings="tnum"
                                android:maxLines="1"
                                android:text="@string/value_none"
                                android:textAppearance="@style/TextAppearance.IceLake.Meta"
                                android:textSize="@dimen/text_body" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/txt_weight_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_l"
                    android:text="@string/game_weight_label"
                    android:textAppearance="@style/TextAppearance.IceLake.Label" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_weight"
                    style="@style/Widget.App.Slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/game_weight_desc"
                    android:stepSize="0.1"
                    android:value="1.2"
                    android:valueFrom="0.1"
                    android:valueTo="8.0" />

                <TextView
                    android:id="@+id/txt_length_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/game_length_label"
                    android:textAppearance="@style/TextAppearance.IceLake.Label" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_length"
                    style="@style/Widget.App.Slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/game_length_desc"
                    android:stepSize="1.0"
                    android:value="42.0"
                    android:valueFrom="10.0"
                    android:valueTo="120.0" />

                <com.icelake.fishinglog.core.ui.ChipRowView
                    android:id="@+id/row_bait"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m" />

                <com.icelake.fishinglog.core.ui.ChipRowView
                    android:id="@+id/row_weather"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_notes"
                    style="@style/Widget.App.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:hint="@string/game_notes_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_notes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:maxLines="2"
                        android:minLines="2"
                        android:textSize="@dimen/text_small" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/game_action_band"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_strip"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_m"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="72dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/txt_game_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/game_strip_desc"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/value_none"
            android:textAppearance="@style/TextAppearance.IceLake.Meta" />

        <TextView
            android:id="@+id/txt_game_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:maxLines="1"
            android:text="@string/game_warning"
            android:textColor="@color/ice_accent"
            android:textSize="@dimen/text_meta"
            android:visibility="invisible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_catch"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_primary_height"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/game_save"
            app:icon="@drawable/ic_check" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
