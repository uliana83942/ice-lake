<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_m"
        android:paddingTop="@dimen/space_s"
        android:paddingEnd="@dimen/space_m"
        android:paddingBottom="@dimen/space_s">

        <View
            android:id="@+id/stat_accent_dot"
            android:layout_width="@dimen/space_s"
            android:layout_height="@dimen/space_s"
            android:background="@drawable/shape_accent_dot" />

        <TextView
            android:id="@+id/txt_stat_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:accessibilityLiveRegion="polite"
            android:maxLines="1"
            android:text="@string/value_none"
            android:textAppearance="@style/TextAppearance.IceLake.Numeric"
            android:textSize="@dimen/text_numeric_small" />

        <TextView
            android:id="@+id/txt_stat_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/value_none"
            android:textAppearance="@style/TextAppearance.IceLake.Label" />

    </LinearLayout>

</merge>
