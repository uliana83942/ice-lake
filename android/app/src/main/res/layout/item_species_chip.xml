<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/species_chip_root"
    android:layout_width="@dimen/species_chip_size"
    android:layout_height="@dimen/species_chip_size"
    android:layout_marginEnd="@dimen/space_m"
    android:background="@drawable/shape_chip_idle"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/img_species"
        android:layout_width="@dimen/species_sprite_size"
        android:layout_height="@dimen/species_sprite_size"
        android:layout_gravity="center"
        android:contentDescription="@string/spot_art_desc"
        android:scaleType="fitCenter"
        android:src="@drawable/sprite_fish_pike" />

</FrameLayout>
