<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/spot_dialog_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_dialog_surface"
    android:elevation="@dimen/elevation_dialog"
    android:paddingStart="@dimen/space_xl"
    android:paddingTop="@dimen/space_xl"
    android:paddingEnd="@dimen/space_xl"
    android:paddingBottom="@dimen/space_xl">

    <TextView
        android:id="@+id/txt_spot_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_centerVertical="false"
        android:text="@string/spot_library_title"
        android:textAppearance="@style/TextAppearance.IceLake.Title" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_spot_dialog_close"
        style="@style/Widget.App.Button.Icon"
        android:layout_width="@dimen/touch_target"
        android:layout_height="@dimen/touch_target"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:contentDescription="@string/spot_library_close_desc"
        app:icon="@drawable/ic_close" />

    <View
        android:id="@+id/spot_dialog_rule"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline"
        android:layout_below="@id/btn_spot_dialog_close"
        android:layout_marginTop="@dimen/space_s"
        android:background="@drawable/shape_hairline" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_spot_use"
        style="@style/Widget.App.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_secondary_height"
        android:layout_alignParentBottom="true"
        android:text="@string/spot_library_use"
        app:icon="@drawable/ic_pin" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list_spots"
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:layout_above="@id/btn_spot_use"
        android:layout_below="@id/spot_dialog_rule"
        android:layout_marginTop="@dimen/space_m"
        android:layout_marginBottom="@dimen/space_m"
        android:clipToPadding="false" />

</RelativeLayout>
