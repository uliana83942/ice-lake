<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/result_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_result_gradient">

    <ImageView
        android:id="@+id/img_result_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.22"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_game"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/result_scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/scrim_result"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txt_result_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        android:letterSpacing="0.18"
        android:paddingTop="@dimen/status_bar_pad"
        android:text="@string/result_title"
        android:textColor="@color/ice_on_dark_muted"
        android:textSize="@dimen/text_meta"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txt_result_saved"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/space_xs"
        android:layout_marginEnd="@dimen/screen_margin"
        android:text="@string/result_saved_label"
        android:textAppearance="@style/TextAppearance.IceLake.Headline"
        android:textColor="@color/ice_on_dark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txt_result_title" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_hero"
        style="@style/Widget.App.Card.Soft"
        android:layout_width="0dp"
        android:layout_height="@dimen/hero_card_height"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/space_l"
        android:layout_marginEnd="@dimen/screen_margin"
        app:cardBackgroundColor="@color/card_result"
        app:cardCornerRadius="@dimen/radius_xl"
        app:cardElevation="@dimen/elevation_l"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txt_result_saved">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_xl"
            android:paddingEnd="@dimen/space_xl">

            <ImageView
                android:id="@+id/img_hero_species"
                android:layout_width="@dimen/hero_sprite_size"
                android:layout_height="@dimen/hero_sprite_size"
                android:contentDescription="@string/game_preview_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/sprite_fish_pike" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_l"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_hero_weight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:text="@string/value_none"
                    android:textAppearance="@style/TextAppearance.IceLake.Numeric"
                    android:textSize="@dimen/text_numeric_large" />

                <TextView
                    android:id="@+id/txt_hero_species"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/value_none"
                    android:textAppearance="@style/TextAppearance.IceLake.Body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_hero_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:background="@drawable/shape_badge_best"
                    android:paddingStart="@dimen/space_s"
                    android:paddingTop="@dimen/space_xs"
                    android:paddingEnd="@dimen/space_s"
                    android:paddingBottom="@dimen/space_xs"
                    android:text="@string/result_personal_best"
                    android:textColor="@color/ice_accent"
                    android:textSize="@dimen/text_meta"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/result_stat_row_1"
        android:layout_width="0dp"
        android:layout_height="@dimen/stat_card_height"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/space_l"
        android:layout_marginEnd="@dimen/screen_margin"
        android:baselineAligned="false"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_hero">

        <com.icelake.fishinglog.core.ui.StatCardView
            android:id="@+id/stat_result_length"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <com.icelake.fishinglog.core.ui.StatCardView
            android:id="@+id/stat_result_bait"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/space_m"
            android:layout_weight="1" />

        <com.icelake.fishinglog.core.ui.StatCardView
            android:id="@+id/stat_result_weather"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/space_m"
            android:layout_weight="1" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/result_stat_row_2"
        android:layout_width="0dp"
        android:layout_height="@dimen/stat_card_height"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/space_m"
        android:layout_marginEnd="@dimen/screen_margin"
        android:baselineAligned="false"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/result_stat_row_1">

        <com.icelake.fishinglog.core.ui.StatCardView
            android:id="@+id/stat_result_spot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <com.icelake.fishinglog.core.ui.StatCardView
            android:id="@+id/stat_result_ice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/space_m"
            android:layout_weight="1" />

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_result_notes"
        style="@style/Widget.App.Card.Soft"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/space_l"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/space_l"
        app:cardBackgroundColor="@color/card_translucent"
        app:cardCornerRadius="@dimen/radius_m"
        app:layout_constraintBottom_toTopOf="@id/btn_log_again"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/result_stat_row_2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/space_l">

            <TextView
                android:id="@+id/txt_result_notes_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/result_notes_header"
                android:textAppearance="@style/TextAppearance.IceLake.Label" />

            <TextView
                android:id="@+id/txt_result_notes"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/space_s"
                android:layout_weight="1"
                android:ellipsize="end"
                android:text="@string/value_none"
                android:textAppearance="@style/TextAppearance.IceLake.Body"
                android:textSize="@dimen/text_small" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_log_again"
        style="@style/Widget.App.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_result_height"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/space_m"
        android:text="@string/result_again"
        app:icon="@drawable/ic_plus"
        app:layout_constraintBottom_toTopOf="@id/btn_result_menu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_result_menu"
        style="@style/Widget.App.Button.Secondary"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_secondary_height"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/space_l"
        android:text="@string/result_menu"
        app:icon="@drawable/ic_journal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
